_campus_network() {
    local cur="${COMP_WORDS[COMP_CWORD]}"
    local commands="login logout relogin status help version"
    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=($(compgen -W "$commands" -- "$cur"))
    elif [ "${COMP_WORDS[1]}" = "login" ] && [ "$COMP_CWORD" -eq 4 ]; then
        COMPREPLY=($(compgen -W "1 2 3 4" -- "$cur"))
    fi
}
complete -F _campus_network campus-network

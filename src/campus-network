def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except FileNotFoundError:
        return default


def atomic_json(path, value):
    path = Path(path)
    fd, temporary = tempfile.mkstemp(prefix="." + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(value, stream, ensure_ascii=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        if sys.platform == "linux":
            directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def migrate_probe_config(path):
    """Replace only the exact former defaults, preserving administrator choices."""
    config = read_json(path, {})
    if not isinstance(config, dict) or config.get("probe_urls") != LEGACY_PROBE_URLS:
        return
    backup = path.with_name(path.name + ".pre-3.0.1")
    if not backup.exists():
        atomic_json(backup, config)
    config["probe_urls"] = DEFAULT_CONFIG["probe_urls"]
    atomic_json(path, config)
    logging.info("已修正旧版默认外网探测配置，原配置备份至 %s", backup)


def load_config(path):
    config = dict(DEFAULT_CONFIG, **read_json(path, {}))
    for key in ("check_interval", "connect_timeout", "request_timeout", "retry_base", "retry_max", "initial_jitter", "cooldown", "displacement_confirm"):
        value = config[key]
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < (0 if key == "initial_jitter" else .01):
            raise ValueError("配置 %s 必须是有效的时间间隔" % key)
    if config["initial_jitter"] > 30 or config["request_timeout"] > 8 or config["connect_timeout"] > config["request_timeout"]:
        raise ValueError("initial_jitter 不得超过 30 秒，请求超时不得超过 8 秒，连接超时不得超过总超时")
    if config["retry_max"] < config["retry_base"]:
        raise ValueError("retry_max 不得小于 retry_base")
    if not isinstance(config["interface"], str) or len(config["interface"]) > 15:
        raise ValueError("interface 必须是 Linux 网卡名或空字符串")
    for key in ("portal", "test_url"):
        parsed = urlsplit(config[key])
        if parsed.scheme not in ("http", "https") or not parsed.hostname or parsed.username:
            raise ValueError("无效的 URL：" + key)
    if not config["probe_urls"] or len(config["probe_urls"]) > 2:
        raise ValueError("配置一到两个 HTTPS 外网探测地址")
    for probe in config["probe_urls"]:
        if urlsplit(probe["url"]).scheme != "https" or not isinstance(probe["status"], int):
            raise ValueError("外网探测必须使用 HTTPS 和明确的 status")
        if probe["status"] != 204 and not probe.get("contains"):
            raise ValueError("非 204 探测必须配置 contains")
    return config


def valid_account(value):
    if not isinstance(value, dict):
        raise ValueError("账号配置必须是对象")
    if any(not isinstance(value.get(k), str) or not 0 < len(value[k]) <= 512 for k in ("username", "password")):
        raise ValueError("账号和密码不能为空，且不得超过 512 个字符")
    if re.search(r"[\x00-\x1f\x7f-\x9f]", value["username"]):
        raise ValueError("账号不得包含控制字符")
    if value.get("service") not in SERVICES:
        raise ValueError("运营商必须是移动、电信、联通或校园网")
    return {key: value[key] for key in ("username", "password", "service")}


def shell_values(path, keys):
    values = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        key, separator, value = line.partition("=")
        if separator and key in keys:
            if value.startswith("$'"):
                values[key] = ast.literal_eval(value[1:].replace(r"\e", r"\x1b").replace(r"\E", r"\x1b"))
                if value.isascii() and re.search(r"\\(?:[0-7]{3}|x[0-9a-fA-F]{2})", value):
                    try:
                        values[key] = values[key].encode("latin1").decode("utf-8")
                    except UnicodeError:
                        pass
            else:
                parts = shlex.split(value, comments=False)
                values[key] = parts[0] if len(parts) == 1 else ""
    return values


def migrate_legacy(account_path, state_dir):
    # The old account file was world-writable: parse data, never execute it.
    if not account_path.exists():
        old_config = account_path.with_name("config")
        config_path = account_path.with_name("config.json")
        if old_config.exists():
            config = read_json(config_path, {})
            for key, value in shell_values(old_config, ("PORTAL", "TEST_URL")).items():
                new_key = {"PORTAL": "portal", "TEST_URL": "test_url"}[key]
                if config.get(new_key, DEFAULT_CONFIG[new_key]) == DEFAULT_CONFIG[new_key]:
                    config[new_key] = value
            atomic_json(config_path, config)
        old = account_path.with_name("account")
        if old.exists():
            try:
                values = shell_values(old, ("USER", "PASS", "SERVICE"))
                atomic_json(account_path, valid_account({
                    "username": values.get("USER"), "password": values.get("PASS"), "service": values.get("SERVICE"),
                }))
                old.chmod(0o600)
                logging.info("已迁移旧账号配置")
            except (ValueError, SyntaxError):
                logging.warning("旧账号配置无法自动迁移；请执行 campus-network config")
    old_index = state_dir / "userindex"
    if not (state_dir / "state.json").exists() and old_index.exists():
        atomic_json(state_dir / "state.json", {
            "mode": "off", "session": old_index.read_text().strip(), "generation": 0,
        })
        old_index.unlink()


class Portal:
    def __init__(self, config, runner=None):
        self.config = dict(DEFAULT_CONFIG, **config)
        self.runner = runner or subprocess.run
        self.interface = self.config["interface"]
        self.cancelled = lambda: False

    def request(self, url, fields=None, headers=None, timeout=None):
        timeout = timeout or self.config["request_timeout"]
        command = ["curl", "-q", "-sS", "--ipv4", "--noproxy", "*", "--proto", "=http,https",
                   "--connect-timeout", str(self.config["connect_timeout"]), "--max-time", str(timeout),
                   "--max-filesize", "1048576", "--write-out", "\n%{http_code}"]
        if self.interface:
            command += ["--interface", self.interface]
        if self.config.get("namespace"):
            command = ["ip", "netns", "exec", self.config["namespace"]] + command
        for key, value in (headers or {}).items():
            command += ["-H", key + ": " + value]
        data = None
        if fields is not None:
            command += ["-X", "POST", "--data-binary", "@-"]
            data = urlencode(fields, quote_via=quote).encode("utf-8")
        command += ["--url", url]
        result = self.runner(command, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout + 1)
        if result.returncode:
            raise OSError("HTTP 请求失败（curl %s）" % result.returncode)
        body, _, status = result.stdout.decode("utf-8", errors="replace").rpartition("\n")
        return int(status), body

    def probe(self):
        captive = None
        try:
            _, body = self.request(self.config["test_url"], timeout=min(3, self.config["request_timeout"]))
            match = re.search(r"index\.jsp\?([^'\"<>\s]+)", body)
            if match:
                captive = {"kind": "portal", "query": html.unescape(match[1]), "reason": "需要进行校园网认证"}
                if not getattr(self, "verify_portal", False):
                    return captive
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
        for probe in self.config["probe_urls"]:
            if self.cancelled():
                break
            try:
                status, body = self.request(probe["url"], timeout=min(3, self.config["request_timeout"]))
                if status == probe["status"] and probe.get("contains", "") in body:
                    return {"kind": "online", "reason": "外网连通性检查通过"}
            except (OSError, ValueError, subprocess.TimeoutExpired):
                pass
        return captive or {"kind": "unknown", "reason": "外网连通性检查未通过，等待网络或认证服务恢复"}

    def login(self, account, query):
        portal = self.config["portal"].rstrip("/")
        _, body = self.request(portal + "/eportal/InterFace.do?method=login", fields={
            "userId": account["username"], "password": account["password"], "service": account["service"],
            "queryString": query, "operatorPwd": "", "operatorUserId": "", "validcode": "", "passwordEncrypt": "false",
        }, headers={
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "User-Agent": "Mozilla/5.0 (X11; Linux aarch64)",
            "Referer": portal + "/eportal/index.jsp?" + query, "Origin": portal,
        })
        result = json.loads(body)
        if not isinstance(result, dict):
            raise ValueError("认证响应必须是对象")
        return result

    def logout(self, user_index):
        _, body = self.request(self.config["portal"].rstrip("/") + "/eportal/InterFace.do?method=logout",
                               fields={"userIndex": user_index})
        result = json.loads(body)
        if not isinstance(result, dict):
            raise ValueError("注销响应必须是对象")
        return result


def inspect_network(interface=""):
    import fcntl
    import struct

    routes = []
    for line in Path("/proc/net/route").read_text().splitlines()[1:]:
        row = line.split()
        if len(row) >= 8 and row[1] == "00000000" and int(row[3], 16) & 1:
            routes.append(row)
    routes.sort(key=lambda row: int(row[6]))
    route = next((row for row in routes if not interface or row[0] == interface), None)
    interface = interface or (route[0] if route else "")
    carrier, address = "unknown", ""
    if interface:
        try:
            carrier = (Path("/sys/class/net") / interface / "carrier").read_text().strip()
        except OSError:
            pass
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
                answer = fcntl.ioctl(sock.fileno(), 0x8915, struct.pack("256s", interface.encode()[:15]))
                address = socket.inet_ntoa(answer[20:24])
        except OSError:
            pass
    ready = bool(interface and route and address and carrier != "0")
    return {"ready": ready, "interface": interface, "source_address": address, "link": carrier != "0",
            "signature": (interface, carrier, address, tuple(route[i] for i in (0, 1, 2, 3, 6, 7)) if route else ()),
            "reason": "网络链路未连接" if carrier == "0" else "等待网卡、IPv4 地址或默认路由就绪"}


class Controller:
    """Single-session I/O engine; PoolController owns allocation and cooldown policy."""
    def __init__(self, config, state_dir, account_path, portal=None, network=None, clock=time.monotonic, rng=random.uniform):
        self.config = dict(DEFAULT_CONFIG, **config)
        self.state_dir, self.account_path = Path(state_dir), Path(account_path)
        self.state_dir.mkdir(parents=True, exist_ok=True)
        self.state_path = self.state_dir / "state.json"
        self.state = read_json(self.state_path, {"mode": "off", "session": "", "generation": 0})
        if (self.state.get("mode") not in ("on", "off") or not isinstance(self.state.get("session"), str)
                or not isinstance(self.state.get("generation"), int)):
            raise ValueError("持久状态损坏，请检查 state.json；为避免抢占账号，拒绝自动登录")
        self.portal = portal or Portal(self.config)
        self.network = network or (lambda: inspect_network(self.config["interface"]))
        self.clock, self.rng = clock, rng
        self.lock, self.wake = threading.RLock(), threading.Event()
        self.failures, self.next_action, self.last_network = 0, 0, None
        self.heartbeat = time.time()
        self.status = {"state": "starting", "reason": "正在检查", "last_online": None, "changed_at": time.time()}

    def _save(self, **updates):
        state = dict(self.state, **updates)
        atomic_json(self.state_path, state)
        self.state = state

    def _account(self):
        try:
            value = read_json(self.account_path)
            return valid_account(value) if value is not None else None
        except (OSError, ValueError, TypeError):
            return None

    def _report(self, state, reason):
        with self.lock:
            account = self._account()
            reason = str(reason)
            for secret in ((account or {}).get("password"), self.state["session"]):
                if secret:
                    reason = reason.replace(secret, "***")
            reason = re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", str(reason))[:240]
            if state != self.status["state"] or reason != self.status["reason"]:
                self.status.update(state=state, reason=reason, changed_at=time.time())
                logging.info("%s: %s", state, reason)
            if state == "online":
                self.status["last_online"] = time.time()

    def snapshot(self):
        with self.lock:
            account = self._account()
            status = dict(self.status)
            if time.time() - self.heartbeat > 25:
                status.update(state="service-unresponsive", reason="连接管理服务响应超时，等待 systemd 恢复；连接状态未知")
            return dict(status, mode=self.state["mode"], version=VERSION, configured=bool(account),
                        username=(account or {}).get("username", ""), service=(account or {}).get("service", ""),
                        retry_in=round(max(0, self.next_action - self.clock()), 1), failures=self.failures,
                        pending_release=bool(self.state["mode"] == "off" and (self.state["session"] or self.state.get("uncertain"))),
                        heartbeat=self.heartbeat, pid=os.getpid())

    def command(self, request):
        action = request.get("command")
        if action not in ("on", "off", "status", "config"):
            raise ValueError("仅支持 on、off、status、config")
        with self.lock:
            if action == "config":
                account = valid_account(request.get("account"))
                if self.state["mode"] != "off" or self.state["session"] or self.state.get("uncertain"):
                    raise ValueError("旧会话尚未注销或在线模式已重新启用，原账号保持不变；请稍后重试 config")
                atomic_json(self.account_path, account)
                self._report("idle", "账号配置已保存；执行 campus-network on 启用在线模式")
                return self.snapshot()
            if action != "status":
                if action == "on":
                    if "account" in request:
                        raise ValueError("请使用 campus-network config 配置账号")
                    if not self._account():
                        return {"needs_account": True}
                if self.state["mode"] != action:
                    self._save(mode=action, generation=self.state["generation"] + 1)
                    self.failures, self.next_action = 0, 0
                    self._report("checking" if action == "on" else "releasing" if self.state["session"] or self.state.get("uncertain") else "idle",
                                 "已启用在线模式，将自动维持网络连接" if action == "on" else "已启用离线模式，自动认证已停用")
                self.wake.set()
            return self.snapshot()

    def _retry(self, state, reason):
        with self.lock:
            ceiling = min(self.config["retry_max"], self.config["retry_base"] * 2 ** min(self.failures, 30))
            self.failures += 1
            self.next_action = self.clock() + self.rng(ceiling / 2, ceiling)
            self._report(state, reason)

    def step(self):
        network = self.network()
        with self.lock:
            signature = network["signature"]
            if signature != self.last_network:
                if hasattr(self.portal, "network_changed"):
                    self.portal.network_changed()
                self.last_network = signature
                self.failures = 0
                self.next_action = self.clock() + self.rng(0, self.config["initial_jitter"])
            mode, generation, session = self.state["mode"], self.state["generation"], self.state["session"]
            self.portal.interface = network.get("interface", "") or self.config["interface"]
            if mode == "off" and not session:
                self._report("release-unconfirmed" if self.state.get("uncertain") else "idle",
                             "自动认证已停用；上次认证结果未知，缺少会话标识，无法确认注销状态" if self.state.get("uncertain") else "自动认证已停用，无待注销会话")
                return
            if not network["ready"]:
                self._report("waiting-link" if not network["link"] else "waiting-network",
                             network["reason"] + ("；现有会话等待注销" if mode == "off" else ""))
                return
            if self.clock() < self.next_action:
                return
            account = self._account() if mode == "on" else None
            if mode == "on" and not account:
                self._report("config-error", "账号未配置，请执行 campus-network config")
                return
        try:
            if mode == "off":
                self._report("releasing", "正在向认证服务器提交注销请求")
                result = self.portal.logout(session)
                with self.lock:
                    if result.get("result") == "success" or result.get("message") == "用户已不在线":
                        self._save(session="")
                        self.failures, self.next_action = 0, 0
                        unknown = self.state.get("uncertain") and self.state["mode"] == "off"
                        self._report("release-unconfirmed" if unknown else "idle" if self.state["mode"] == "off" else "checking",
                                     "已注销已知会话；另一次认证结果未知，注销状态尚未确认" if unknown else "会话注销完成")
                    elif self.state["generation"] == generation:
                        self._retry("releasing", result.get("message") or "会话注销失败，将按重试计划重新尝试")
                return
            self.portal.cancelled = lambda: self.state["generation"] != generation or not self.network()["ready"]
            result = self.portal.probe()
            observed_network = self.network()
            with self.lock:
                if self.state["generation"] != generation:
                    return
                if observed_network["signature"] != signature:
                    self.wake.set()
                    return
                if result["kind"] == "online":
                    self.failures = 0
                    self.next_action = self.clock() + self.rng(self.config["check_interval"] * .8, self.config["check_interval"] * 1.2)
                    self._report("online", result["reason"])
                    return
                if result["kind"] != "portal":
                    self._retry("retrying", result["reason"])
                    return
                # Mark the operation in flight before releasing the control lock.
                uncertain_before = self.state.get("uncertain", False)
                self._save(uncertain=True)
                self._report("authenticating", "正在提交校园网认证")
            result = self.portal.login(account, result["query"])
            with self.lock:
                if result.get("result") == "success" and result.get("userIndex"):
                    self._save(session=str(result["userIndex"]), uncertain=False)
                    if self.state["mode"] == "on":
                        self._retry("checking", "认证成功，等待外网连通性确认")
                    else:
                        self.failures, self.next_action = 0, 0
                        self._report("releasing", "认证期间已切换为离线模式，正在注销新会话")
                    self.wake.set()
                else:
                    if result.get("result") != "success":
                        self._save(uncertain=uncertain_before)
                    if self.state["generation"] == generation:
                        self._retry("retrying", result.get("message") or "认证失败或未返回会话索引")
        except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
            with self.lock:
                if self.state["generation"] == generation:
                    reason = "请求超时，认证服务器处理结果尚未确认" if isinstance(exc, subprocess.TimeoutExpired) else "请求失败，将按重试计划重新尝试"
                    self._retry("releasing" if mode == "off" else "retrying", reason)


def valid_ip(value):
    """An entry describes an existing system address; it never provisions one."""
    if not isinstance(value, dict):
        raise ValueError("IP 配置必须是对象")
    result = {key: value.get(key, "") for key in ("address", "interface", "namespace")}
    if not isinstance(result["address"], str):
        raise ValueError("源 IPv4 必须是字符串")
    if result["address"]:
        address = ipaddress.IPv4Address(result["address"])
        if address.is_unspecified or address.is_multicast or int(address) == 0xffffffff:
            raise ValueError("源 IPv4 必须是具体的单播地址")
        result["address"] = str(address)
    for key, maximum in (("interface", 15), ("namespace", 64)):
        if not isinstance(result[key], str) or (result[key] and not re.fullmatch(r"[a-zA-Z0-9_.-]{1,%d}" % maximum, result[key])):
            raise ValueError("无效的 " + key)
    if result["namespace"] and not result["address"]:
        raise ValueError("命名空间出口必须填写源 IPv4 地址")
    return result


def inspect_slot(entry, config):
    if not entry["address"]:
        return inspect_network(entry["interface"] or config["interface"])
    prefix = ["ip", "netns", "exec", entry["namespace"]] if entry["namespace"] else []
    def ip_json(*args):
        output = subprocess.run(prefix + ["ip", "-j"] + list(args), check=True,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=2)
        return json.loads(output.stdout)
    try:
        links = ip_json("address", "show")
        link = next((item for item in links if any(addr.get("local") == entry["address"]
                     for addr in item.get("addr_info", []))), None)
        routes = ip_json("route", "get", "1.1.1.1", "from", entry["address"])
        route = routes[0] if routes else {}
        interface = (link or {}).get("ifname", "")
        ready = bool(link and "UP" in link.get("flags", []) and link.get("operstate") != "DOWN"
                     and route.get("dev") == interface and (not entry["interface"] or entry["interface"] == interface))
        return {"ready": ready, "source_address": entry["address"], "link": bool(link and link.get("operstate") != "DOWN"),
                "interface": entry["address"],
                "signature": (entry["namespace"], interface, entry["address"], ready,
                              tuple(route.get(k, "") for k in ("dev", "gateway", "src", "prefsrc", "table", "type"))),
                "reason": "源地址、接口或源策略路由尚未就绪"}
    except (OSError, ValueError, subprocess.SubprocessError):
        return {"ready": False, "link": False, "interface": entry["address"],
                "signature": (entry["namespace"], entry["address"], False), "reason": "等待出口地址、命名空间及 iproute2"}


class PoolPortal:
    """Gate the single-session engine's reauthentication after a confirmed loss."""
    def __init__(self, owner, slot_id, portal):
        object.__setattr__(self, "owner", owner)
        object.__setattr__(self, "slot_id", slot_id)
        object.__setattr__(self, "portal", portal)
        portal.verify_portal = True
        self.suspected = None
        self.last_kind, self.last_check = "unknown", 0

    def __setattr__(self, key, value):
        if key in ("interface", "cancelled"):
            setattr(self.portal, key, value)
        else:
            object.__setattr__(self, key, value)

    def probe(self):
        result = self.portal.probe()
        with self.owner.lock:
            if result["kind"] == "portal":
                expected = self.owner.readiness.get(self.slot_id, {}).get("source_address")
                advertised = parse_qs(result.get("query", "")).get("wlanuserip", [])
                try:
                    advertised = [str(ipaddress.IPv4Address(value)) for value in advertised]
                except ipaddress.AddressValueError:
                    # ePortal also sends opaque/encoded values. Preserve the query
                    # for the server to interpret; these are not plaintext IPs.
                    advertised = []
                if expected and advertised and advertised != [expected]:
                    result = {"kind": "unknown", "reason": "认证页的源 IP 与当前出口不符，拒绝使用错误的认证参数"}
            self.last_kind, self.last_check = result["kind"], self.owner.clock()
            binding = self.owner.data["bindings"].get(self.slot_id)
            if not binding or binding.get("release") or self.owner.data["mode"] == "off":
                return {"kind": "unknown", "reason": "出口已停止参与分配"}
            if result["kind"] == "online":
                self.suspected = None
                # Never turn unknown/transport-interrupted authentication into an owned session.
                engine = self.owner.engines[self.slot_id]
                if engine.state["session"] and not engine.state.get("uncertain") and not binding.get("online"):
                    binding["online"] = True
                    self.owner._save()
                if not binding.get("online"):
                    result = dict(result, reason="外网可用，但无法确认当前认证账号；保留预留，不冒认会话")
                return result
            if result["kind"] != "portal":
                self.suspected = None
                return result
            if binding.get("online"):
                now = self.owner.clock()
                if self.suspected is None:
                    self.suspected = now
                elif now - self.suspected >= self.owner.config["displacement_confirm"]:
                    others = [self.owner.engines[key].portal for key, b in self.owner.data["bindings"].items()
                              if key != self.slot_id and b.get("online") and not b.get("release")]
                    # Correlated failures are ambiguous; wait for an independent healthy exit.
                    if not others or any(p.last_kind == "online" and p.last_check > self.suspected and now - p.last_check < 20 for p in others):
                        self.owner._displaced(self.slot_id)
                return {"kind": "unknown", "reason": "疑似账号被占用，等待连续认证页及 HTTPS 失败确认"}
            engine = self.owner.engines[self.slot_id]
            if engine.state.get("uncertain"):
                return {"kind": "unknown", "reason": "认证结果未知，保留账号占用以避免重复抢登；需人工确认"}
            if engine.state["session"]:
                return {"kind": "unknown", "reason": "已提交认证，等待外网验证；不会重复提交登录"}
            return result

    def login(self, account, query):
        result = self.portal.login(account, query)
        message = str(result.get("message", "")).lower()
        account_error = any(word in message for word in ("密码", "不存在", "用户名错误", "限制", "欠费", "停机", "禁用", "运营商用户认证失败", "password", "restricted", "invalid user"))
        if result.get("result") != "success" and account_error:
            # Only definite account errors enter cooldown; server-busy errors back off.
            with self.owner.lock:
                binding = self.owner.data["bindings"].get(self.slot_id)
                if binding:
                    account = self.owner._find("accounts", binding["account"])
                    account["cooldown_until"] = self.owner.wall() + self.owner.config["cooldown"]
                    account["cooldown_reason"] = "认证被拒绝，请检查账号、密码或运营商限制"
                    binding["release"] = True
                    self.owner._save()
        return result

    def logout(self, session):
        return self.portal.logout(session)

    def network_changed(self):
        self.suspected = None
        self.last_kind, self.last_check = "unknown", 0


class PoolController:
    """One durable allocator, independent bounded I/O workers for each IP.

    pool.json is the transaction boundary for credentials, reservations and cooldowns.
    Session engines journal their own in-flight login before sending it. Reservations
    are written first and deleted last, so interrupted transitions fail closed.
    """
    def __init__(self, config, state_dir, account_path, portal_factory=None, network=None,
                 clock=time.monotonic, wall=time.time, rng=random.uniform):
        self.config = dict(DEFAULT_CONFIG, **config)
        self.root, self.account_path = Path(state_dir), Path(account_path)
        self.root.mkdir(parents=True, exist_ok=True)
        self.path = self.root / "pool.json"
        self.lock, self.wake = threading.RLock(), threading.Event()
        self.clock, self.wall, self.rng = clock, wall, rng
        self.heartbeat = time.time()
        self.portal_factory = portal_factory or Portal
        self.network = network or (lambda item: inspect_slot(item, self.config))
        self.engines, self.workers, self.worker_errors, self.readiness = {}, {}, {}, {}
        if self.path.exists():
            self.data = read_json(self.path)
            self._validate()
            if not self.data["accounts"] and self.account_path.exists():
                self.data["accounts"] = [dict(valid_account(read_json(self.account_path)), id="primary", enabled=True, cooldown_until=0)]
                self.data["primary_account"] = "primary"
                self._save()
        else:
            old = read_json(self.root / "state.json", {"mode": "off", "session": "", "generation": 0})
            if old.get("mode") not in ("on", "off") or not isinstance(old.get("session"), str):
                raise ValueError("旧状态损坏，拒绝自动迁移")
            account = read_json(self.account_path)
            accounts = [dict(valid_account(account), id="primary", enabled=True, cooldown_until=0)] if account else []
            if not accounts and (old["session"] or old.get("uncertain")):
                raise ValueError("旧会话存在但账号不可读，请修复原账号后迁移")
            self.data = {"schema": 1, "mode": old["mode"], "accounts": accounts,
                         "ips": [dict(id="primary", enabled=True, address="", interface=self.config["interface"], namespace="")],
                         "primary_account": "primary" if accounts else "", "primary_ip": "primary", "bindings": {}}
            if old["session"] or old.get("uncertain"):
                directory = self.root / "slots" / "primary"
                directory.mkdir(parents=True, exist_ok=True, mode=0o700)
                atomic_json(directory / "state.json", old)
                self.data["bindings"]["primary"] = {"account": "primary", "online": bool(old["session"]), "release": old["mode"] == "off"}
            self._save()
        for slot_id in self.data["bindings"]:
            self._engine(slot_id)

    def _validate(self):
        data = self.data
        if not isinstance(data, dict) or data.get("schema") != 1 or data.get("mode") not in ("on", "off"):
            raise ValueError("账号池状态损坏，拒绝自动登录")
        for kind, limit in (("accounts", 64), ("ips", 16)):
            items = data.get(kind)
            if not isinstance(items, list) or len(items) > limit:
                raise ValueError("账号池或 IP 池损坏")
            seen = set()
            for item in items:
                ident = item.get("id", "")
                if not isinstance(ident, str) or not re.fullmatch(r"[a-zA-Z0-9_-]{1,64}", ident) or ident in seen:
                    raise ValueError("池条目标识无效或重复")
                seen.add(ident)
                if type(item.get("enabled")) is not bool:
                    raise ValueError("启用状态必须是布尔值")
                if kind == "accounts":
                    valid_account(item)
                    cd = item.get("cooldown_until", 0)
                    if isinstance(cd, bool) or not isinstance(cd, (int, float)) or not math.isfinite(cd) or cd < 0:
                        raise ValueError("冷却时间损坏")
                else:
                    valid_ip(item)
        if data.get("primary_ip") not in {item["id"] for item in data["ips"]}:
            raise ValueError("缺少主 IP")
        if data.get("primary_account") and data["primary_account"] not in {item["id"] for item in data["accounts"]}:
            raise ValueError("主账号不存在")
        identities = [a["username"] for a in data["accounts"]]
        addresses = [(a["namespace"], a["address"]) for a in data["ips"]]
        if len(set(identities)) != len(identities) or len(set(addresses)) != len(addresses):
            raise ValueError("账号或出口地址重复")
        bindings = data.get("bindings")
        if not isinstance(bindings, dict):
            raise ValueError("分配状态损坏")
        used = set()
        for slot_id, binding in bindings.items():
            self._find("ips", slot_id)
            self._find("accounts", binding["account"])
            if binding["account"] in used:
                raise ValueError("同一账号存在多个占用，拒绝自动登录")
            used.add(binding["account"])

    def _find(self, kind, ident):
        for item in self.data[kind]:
            if item["id"] == ident:
                return item
        raise ValueError("条目不存在")

    def _save(self):
        atomic_json(self.path, self.data)

    def _engine(self, slot_id):
        if slot_id not in self.engines:
            item = self._find("ips", slot_id)
            account = self._find("accounts", self.data["bindings"][slot_id]["account"])
            directory = self.root / "slots" / slot_id
            directory.mkdir(parents=True, exist_ok=True, mode=0o700)
            atomic_json(directory / "account.json", valid_account(account))
            config = dict(self.config, namespace=item["namespace"], source_address=item["address"])
            portal = PoolPortal(self, slot_id, self.portal_factory(config))
            self.engines[slot_id] = Controller(config, directory, directory / "account.json", portal=portal,
                                               network=lambda: self.network(item), clock=self.clock, rng=self.rng)
            if self.data["bindings"][slot_id].get("displaced"):
                engine = self.engines[slot_id]
                engine._save(mode="off", session="", uncertain=False, generation=engine.state["generation"] + 1)
        return self.engines[slot_id]

    def _displaced(self, slot_id):
        binding = self.data["bindings"][slot_id]
        account = self._find("accounts", binding["account"])
        account.update(cooldown_until=self.wall() + self.config["cooldown"], cooldown_reason="疑似账号在其他设备使用")
        # Never send a stale logout or re-login after displacement: that can evict a student.
        binding.update(release=True, displaced=True)
        self._save()
        engine = self.engines[slot_id]
        engine.command({"command": "off"})
        with engine.lock:
            engine._save(session="", uncertain=False)
        self.wake.set()

    def snapshot(self):
        with self.lock:
            ips = []
            for item in self.data["ips"]:
                binding = self.data["bindings"].get(item["id"])
                engine = self.engines.get(item["id"])
                status = engine.snapshot() if engine else {"state": "disabled" if not item["enabled"] else "waiting-account", "reason": "等待可用账号"}
                network = self.readiness.get(item["id"])
                if not engine and item["enabled"] and network and not network["ready"]:
                    status.update(state="waiting-network", reason=network["reason"])
                if item["id"] in self.worker_errors:
                    status.update(state="worker-error", reason="出口处理异常，请检查服务日志")
                if status["state"] == "online" and binding and not binding.get("online"):
                    status["state"] = "online-unowned"
                ips.append(dict(item, primary=item["id"] == self.data["primary_ip"],
                                ownership="verified" if binding and binding.get("online") else "unconfirmed" if binding else "none",
                                account_id=binding["account"] if binding else "", **{k: status.get(k) for k in ("state", "reason", "pending_release", "retry_in")}))
            accounts = [{k: item[k] for k in ("id", "username", "service", "enabled")} for item in self.data["accounts"]]
            for public, item in zip(accounts, self.data["accounts"]):
                public.update(primary=item["id"] == self.data["primary_account"],
                              cooldown_in=max(0, math.ceil(item.get("cooldown_until", 0) - self.wall())),
                              cooldown_reason=item.get("cooldown_reason", ""),
                              ip_id=next((key for key, b in self.data["bindings"].items() if b["account"] == item["id"]), ""))
            primary = next(item for item in ips if item["primary"])
            account = next((a for a in accounts if a["id"] == primary["account_id"]), {})
            return {"mode": self.data["mode"], "version": VERSION, "state": primary["state"] if self.data["mode"] == "on" else "releasing" if self.data["bindings"] else "idle",
                    "reason": primary["reason"] or "等待分配", "configured": bool(accounts),
                    "username": account.get("username", ""), "service": account.get("service", ""),
                    "pending_release": any(b.get("release") or self.data["mode"] == "off" for b in self.data["bindings"].values()),
                    "changed_at": self.wall(), "heartbeat": self.heartbeat, "pid": os.getpid(), "ips": ips, "accounts": accounts}

    def command(self, request):
        action = request.get("command")
        with self.lock:
            if action in ("on", "off"):
                if "account" in request:
                    raise ValueError("请使用 config 配置账号池")
                if action == "on" and not any(a["enabled"] for a in self.data["accounts"]):
                    return {"needs_account": True}
                self.data["mode"] = action
            elif action == "pool-add":
                kind = request.get("kind")
                if kind not in ("ips", "accounts"):
                    raise ValueError("kind 必须为 ips 或 accounts")
                if len(self.data[kind]) >= (16 if kind == "ips" else 64):
                    raise ValueError("池已达到条目上限")
                value = valid_ip(request.get("value")) if kind == "ips" else valid_account(request.get("value"))
                if kind == "ips" and not value["address"]:
                    raise ValueError("副 IP 必须填写明确的源 IPv4 地址")
                for item in self.data[kind]:
                    keys = ("namespace", "address") if kind == "ips" else ("username",)
                    if all(item[key] == value[key] for key in keys):
                        raise ValueError("该账号或出口已存在")
                value.update(id=uuid.uuid4().hex, enabled=True)
                if kind == "accounts":
                    value["cooldown_until"] = 0
                self.data[kind].append(value)
                if kind == "accounts" and not self.data["primary_account"]:
                    self.data["primary_account"] = value["id"]
            elif action in ("pool-enable", "pool-primary", "pool-edit"):
                kind = request.get("kind")
                if kind not in ("ips", "accounts"):
                    raise ValueError("kind 必须为 ips 或 accounts")
                item = self._find(kind, request.get("id"))
                if action == "pool-enable":
                    if type(request.get("enabled")) is not bool:
                        raise ValueError("enabled 必须是布尔值")
                    item["enabled"] = request["enabled"]
                elif action == "pool-primary":
                    self.data["primary_ip" if kind == "ips" else "primary_account"] = item["id"]
                else:
                    if item["enabled"] or any(key == item["id"] if kind == "ips" else b["account"] == item["id"] for key, b in self.data["bindings"].items()):
                        raise ValueError("请先禁用条目并等待会话释放后再编辑")
                    value = valid_ip(request.get("value")) if kind == "ips" else valid_account(request.get("value"))
                    if kind == "ips" and not value["address"] and item["id"] != self.data["primary_ip"]:
                        raise ValueError("仅主 IP 可以自动检测地址")
                    keys = ("namespace", "address") if kind == "ips" else ("username",)
                    if any(other["id"] != item["id"] and all(other[k] == value[k] for k in keys) for other in self.data[kind]):
                        raise ValueError("该账号或出口已存在")
                    item.update(value)  # deliberately retain the cooldown
            elif action == "config":
                # Compatibility for old automation; never replace an active account.
                account = valid_account(request.get("account"))
                if self.data["mode"] != "off" or self.data["bindings"]:
                    raise ValueError("请先 off 并等待所有旧会话释放")
                primary = self.data["primary_account"]
                if primary:
                    item = self._find("accounts", primary)
                    if any(a["id"] != primary and a["username"] == account["username"] for a in self.data["accounts"]):
                        raise ValueError("该账号已存在")
                    item.update(account)
                else:
                    self.data["accounts"].append(dict(account, id="primary", enabled=True, cooldown_until=0))
                    self.data["primary_account"] = "primary"
            elif action != "status":
                raise ValueError("不支持的控制命令")
            if action != "status":
                self._save()
                # Stop immediately, including workers currently in probe/login.
                self._stop_ineligible()
                self.wake.set()
            return self.snapshot()

    def _stop_ineligible(self):
        changed = False
        for slot_id, binding in self.data["bindings"].items():
            if (self.data["mode"] == "off" or not self._find("ips", slot_id)["enabled"]
                    or not self._find("accounts", binding["account"])["enabled"] or binding.get("release")):
                if not binding.get("release"):
                    binding["release"] = True
                    changed = True
                self._engine(slot_id).command({"command": "off"})
        if changed:
            self._save()

    def _assign(self, item, account):
        slot_id = item["id"]
        self.data["bindings"][slot_id] = {"account": account["id"], "online": False, "release": False}
        self._save()  # reservation before any engine can submit authentication
        self._engine(slot_id).command({"command": "on"})

    def _run(self, slot_id):
        try:
            self.engines[slot_id].step()
            with self.lock:
                self.worker_errors.pop(slot_id, None)
                binding = self.data["bindings"].get(slot_id)
                engine = self.engines[slot_id]
                if binding and binding.get("handoff") and engine.state["mode"] == "off" and not engine.state.get("uncertain"):
                    # A new login on the main IP evicts this known local session even
                    # when the portal's logout is delayed. No stale retry may follow it.
                    with engine.lock:
                        engine._save(session="", generation=engine.state["generation"] + 1)
        except Exception:
            logging.exception("出口处理失败：%s", slot_id)
            with self.lock:
                self.worker_errors[slot_id] = True
        finally:
            self.engines[slot_id].heartbeat = time.time()
            self.wake.set()

    def step(self, wait=False):
        launched = []
        with self.lock:
            candidates = [dict(i) for i in self.data["ips"] if i["enabled"]]
        with ThreadPoolExecutor(max_workers=16) as executor:
            ready = dict(zip((i["id"] for i in candidates), executor.map(self.network, candidates)))
        with self.lock:
            self.readiness = ready
            self._stop_ineligible()
            for slot_id, binding in list(self.data["bindings"].items()):
                worker = self.workers.get(slot_id)
                if worker and worker.is_alive():
                    continue
                engine = self._engine(slot_id)
                if binding.get("release") and not engine.state["session"] and not engine.state.get("uncertain"):
                    del self.data["bindings"][slot_id]
                    self.engines.pop(slot_id, None)
                    self.worker_errors.pop(slot_id, None)
                    self._save()
                    continue
                engine.command({"command": "off" if binding.get("release") else "on"})
            if self.data["mode"] == "on":
                primary_id = self.data["primary_ip"]
                items = sorted(self.data["ips"], key=lambda i: i["id"] != primary_id)
                for item in items:
                    if not item["enabled"] or item["id"] in self.data["bindings"]:
                        continue
                    # Don't move a healthy account to an unconfigured or disconnected main IP.
                    if not ready.get(item["id"], {}).get("ready"):
                        continue
                    source = ready[item["id"]].get("source_address")
                    if source and any(ready.get(key, {}).get("source_address") == source
                                      and self._find("ips", key)["namespace"] == item["namespace"] for key in self.data["bindings"]):
                        continue
                    used = {b["account"] for b in self.data["bindings"].values()}
                    available = [a for a in self.data["accounts"] if a["enabled"] and a["id"] not in used
                                 and a.get("cooldown_until", 0) <= self.wall()]
                    if available:
                        available.sort(key=lambda a: (a["id"] != self.data["primary_account"]) if item["id"] == primary_id else (a["id"] == self.data["primary_account"]))
                        self._assign(item, available[0])
                    elif item["id"] == primary_id:
                        for other, binding in self.data["bindings"].items():
                            account = self._find("accounts", binding["account"])
                            engine = self._engine(other)
                            if (other != primary_id and not binding.get("release") and binding.get("online")
                                    and engine.state["session"] and not engine.state.get("uncertain")
                                    and account["enabled"] and account.get("cooldown_until", 0) <= self.wall()):
                                binding["release"] = True
                                binding["handoff"] = primary_id
                                self._engine(other).command({"command": "off"})
                                self._save()
                                break
                        # Reserve the next freed account for the primary; don't feed secondary IPs.
                        break
            for slot_id in list(self.data["bindings"]):
                worker = self.workers.get(slot_id)
                if worker and worker.is_alive():
                    continue
                worker = threading.Thread(target=self._run, args=(slot_id,), daemon=True)
                self.workers[slot_id] = worker
                launched.append(worker)
                worker.start()
        if wait:
            for worker in launched:
                worker.join(30)


def notify(message):
    address = os.environ.get("NOTIFY_SOCKET")
    if address:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
                sock.sendto(message.encode(), "\0" + address[1:] if address.startswith("@") else address)
        except OSError:
            pass


def read_message(stream, limit=8192):
    line = stream.readline(limit + 1)
    if not line.endswith(b"\n") or len(line) > limit:
        raise ValueError("控制消息过长或不完整")
    value = json.loads(line)
    if not isinstance(value, dict):
        raise ValueError("控制消息必须是对象")
    return value


def daemon():
    import fcntl
    import socketserver

    if os.geteuid() != 0:
        raise ValueError("守护进程由 systemd 以 root 启动；日常命令无需 sudo")
    os.umask(0o077)
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    RUNTIME_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    RUNTIME_DIR.chmod(0o755)
    lock = (RUNTIME_DIR / "daemon.lock").open("w")
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    migrate_legacy(CONFIG_DIR / "account.json", STATE_DIR)
    migrate_probe_config(CONFIG_DIR / "config.json")
    config = load_config(CONFIG_DIR / "config.json")
    control = PoolController(config, STATE_DIR, CONFIG_DIR / "account.json")

    class Handler(socketserver.StreamRequestHandler):
        def handle(self):
            self.request.settimeout(2)
            try:
                result = control.command(read_message(self.rfile))
            except ValueError as exc:
                result = {"error": str(exc)}
            except (OSError, TypeError, KeyError):
                result = {"error": "请求无效或配置不可读，请检查服务日志与账号配置"}
            try:
                self.wfile.write((json.dumps(result, ensure_ascii=False) + "\n").encode())
            except OSError:
                pass

    endpoint = RUNTIME_DIR / "control.sock"
    endpoint.unlink(missing_ok=True)
    class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
        daemon_threads = True

    server = Server(str(endpoint), Handler)
    endpoint.chmod(0o666)
    thread = threading.Thread(target=server.serve_forever, kwargs={"poll_interval": .2}, daemon=True)
    thread.start()
    stopping = threading.Event()

    def stop(*_):
        stopping.set()
        control.wake.set()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        while not stopping.is_set():
            control.wake.clear()
            if not thread.is_alive():
                raise RuntimeError("控制服务意外退出")
            control.step()
            control.heartbeat = time.time()
            notify("WATCHDOG=1")
            control.wake.wait(1)
    finally:
        server.shutdown()
        server.server_close()
        endpoint.unlink(missing_ok=True)
        lock.close()


def client(request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(4)
        sock.connect(str(RUNTIME_DIR / "control.sock"))
        sock.sendall((json.dumps(request, ensure_ascii=False) + "\n").encode())
        with sock.makefile("rb") as stream:
            result = read_message(stream, 262144)
    if "error" in result:
        raise ValueError(result["error"])
    return result


def print_status(value):
    labels = {"online": "在线", "idle": "离线", "starting": "启动中", "checking": "检查连接",
              "waiting-link": "等待链路恢复", "waiting-network": "等待网络就绪", "authenticating": "认证中",
              "retrying": "等待重试", "releasing": "正在注销", "release-unconfirmed": "注销未确认",
              "config-error": "配置错误", "service-unresponsive": "服务无响应"}
    state = value.get("state", "starting")
    color = sys.stdout.isatty() and "NO_COLOR" not in os.environ
    text = labels.get(state, state)
    if color:
        text = "\033[%sm%s\033[0m" % ("32" if state == "online" else "36" if state == "idle" else "33", text)
    print("模式：%s    状态：%s" % ("保持在线" if value["mode"] == "on" else "保持离线", text))
    print("说明：" + value["reason"])
    if value.get("username"):
        print("账号：%s @ %s" % (value["username"], value["service"]))
    if value.get("pending_release"):
        print("会话：等待注销确认（自动认证已停用）")
    if value.get("retry_in", 0) > 0 and state != "online":
        print("下次重试：%.1f 秒后" % value["retry_in"])
    if value.get("last_online"):
        print("最近在线：" + time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(value["last_online"])))
    print("状态更新：" + time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(value["changed_at"])))
    for item in value.get("ips", []):
        print("%sIP %s [%s]：%s%s" % ("主 " if item["primary"] else "", item["address"] or "自动检测",
              "启用" if item["enabled"] else "禁用", item["state"], " → " + item["account_id"] if item["account_id"] else ""))
    for item in value.get("accounts", []):
        print("%s账号 %s [%s]%s" % ("主 " if item["primary"] else "", item["username"],
              "启用" if item["enabled"] else "禁用", " 冷却 %d 秒：%s" % (item["cooldown_in"], item["cooldown_reason"]) if item["cooldown_in"] else ""))



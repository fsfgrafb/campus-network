#!/bin/bash
# ============================================================================
# campus-network - 锐捷 ePortal 校园网认证工具
# ============================================================================

set -euo pipefail

VERSION="__VERSION__"

SYSTEM_CONFIG="/etc/campus-network/config"
ACCOUNT_CONFIG="/etc/campus-network/account"
USER_INDEX="/var/lib/campus-network/userindex"

# ============================================================================
# 颜色
# ============================================================================

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RESET='\033[0m'
    BOLD='\033[1m'
    DIM='\033[2m'
    BLUE='\033[34m'
    GREEN='\033[32m'
    YELLOW='\033[33m'
    RED='\033[31m'
    CYAN='\033[36m'
else
    RESET=''
    BOLD=''
    DIM=''
    BLUE=''
    GREEN=''
    YELLOW=''
    RED=''
    CYAN=''
fi

info() {
    printf "${BLUE}→${RESET} %s\n" "$*"
}

success() {
    printf "${GREEN}✓${RESET} %s\n" "$*"
}

warn() {
    printf "${YELLOW}!${RESET} %s\n" "$*" >&2
}

error() {
    printf "${RED}✗${RESET} %s\n" "$*" >&2
}

title() {
    printf "\n${BOLD}${CYAN}%s${RESET}\n" "$*"
}

separator() {
    printf "${DIM}────────────────────────────────────────${RESET}\n"
}

# ============================================================================
# 帮助
# ============================================================================

show_help() {
    cat <<EOF

${BOLD}campus-network${RESET} ${DIM}${VERSION}${RESET}
锐捷 ePortal 校园网认证工具

${BOLD}用法${RESET}
  campus-network login [账号] [密码] [运营商]
  campus-network logout
  campus-network relogin
  campus-network status
  campus-network config
  campus-network version
  campus-network help

${BOLD}登录${RESET}
  不提供参数时，使用上次保存的账号和运营商。
  如果没有保存的账号，将交互式要求输入。

  如果只提供部分参数，将交互式补充剩余参数。

${BOLD}运营商${RESET}
  1) 移动
  2) 电信
  3) 联通
  4) 校园网

${BOLD}示例${RESET}
  campus-network login
  campus-network login Z09124129
  campus-network login Z09124129 20051023
  campus-network login Z09124129 20051023 1

${BOLD}环境变量${RESET}
  NO_COLOR=1    禁用彩色输出

EOF
}

# ============================================================================
# 配置
# ============================================================================

load_system_config() {
    if [ ! -f "$SYSTEM_CONFIG" ]; then
        error "系统配置不存在：$SYSTEM_CONFIG"
        exit 2
    fi

    # shellcheck disable=SC1090
    . "$SYSTEM_CONFIG"

    : "${CONFIG_VERSION:?系统配置缺少 CONFIG_VERSION}"
    : "${PORTAL:?系统配置缺少 PORTAL}"
    : "${TEST_URL:?系统配置缺少 TEST_URL}"
    : "${FALLBACK_URL:?系统配置缺少 FALLBACK_URL}"
}

load_account_config() {
    if [ ! -f "$ACCOUNT_CONFIG" ]; then
        return 1
    fi

    # shellcheck disable=SC1090
    . "$ACCOUNT_CONFIG"

    : "${ACCOUNT_CONFIG_VERSION:?账号配置缺少 ACCOUNT_CONFIG_VERSION}"
    : "${USER:?账号配置缺少 USER}"
    : "${PASS:?账号配置缺少 PASS}"
    : "${SERVICE:?账号配置缺少 SERVICE}"

    if [ "$ACCOUNT_CONFIG_VERSION" != "$CONFIG_VERSION" ]; then
        warn "账号配置版本已过期，将清除旧账号信息。"
        rm -f "$ACCOUNT_CONFIG"
        return 1
    fi

    return 0
}

save_account_config() {
    local user="$1"
    local pass="$2"
    local service="$3"

    mkdir -p "$(dirname "$ACCOUNT_CONFIG")"

    cat > "$ACCOUNT_CONFIG" <<EOF
# campus-network account configuration
# This file is shared by all users.

ACCOUNT_CONFIG_VERSION=$CONFIG_VERSION
USER=$(printf '%q' "$user")
PASS=$(printf '%q' "$pass")
SERVICE=$(printf '%q' "$service")
EOF

    chmod 644 "$ACCOUNT_CONFIG"
}

# ============================================================================
# 运营商
# ============================================================================

choose_service() {
    local choice

    title "选择运营商"

    printf "  ${BOLD}1${RESET}) 移动\n"
    printf "  ${BOLD}2${RESET}) 电信\n"
    printf "  ${BOLD}3${RESET}) 联通\n"
    printf "  ${BOLD}4${RESET}) 校园网\n\n"

    while true; do
        read -r -p "请输入选项 [1-4]: " choice

        case "$choice" in
            1)
                SERVICE="移动"
                break
                ;;
            2)
                SERVICE="电信"
                break
                ;;
            3)
                SERVICE="联通"
                break
                ;;
            4)
                SERVICE="校园网"
                break
                ;;
            *)
                warn "请输入 1、2、3 或 4。"
                ;;
        esac
    done
}

service_to_number() {
    case "$1" in
        移动) echo "1" ;;
        电信) echo "2" ;;
        联通) echo "3" ;;
        校园网) echo "4" ;;
        *) echo "?" ;;
    esac
}

# ============================================================================
# 登录
# ============================================================================

do_login() {
    local user="${1:-}"
    local pass="${2:-}"
    local service_number="${3:-}"

    title "校园网认证"

    # ------------------------------------------------------------------------
    # 读取历史账号
    # ------------------------------------------------------------------------

    if [ -z "$user" ] && [ -z "$pass" ] && [ -z "$service_number" ]; then
        if load_account_config; then
            user="$USER"
            pass="$PASS"
            SERVICE="$SERVICE"

            info "使用上次保存的账号"
            printf "  账号：${BOLD}%s${RESET}\n" "$user"
            printf "  运营商：${BOLD}%s${RESET}\n" "$SERVICE"
        else
            info "未找到已保存的账号，请输入登录信息。"

            read -r -p "账号： " user

            while [ -z "$user" ]; do
                warn "账号不能为空。"
                read -r -p "账号： " user
            done

            read -r -s -p "密码： " pass
            echo

            while [ -z "$pass" ]; do
                warn "密码不能为空。"
                read -r -s -p "密码： " pass
                echo
            done

            choose_service
        fi

    else
        # --------------------------------------------------------------------
        # 部分参数：补齐剩余参数
        # --------------------------------------------------------------------

        if [ -z "$user" ]; then
            read -r -p "账号： " user
        fi

        if [ -z "$pass" ]; then
            read -r -s -p "密码： " pass
            echo
        fi

        if [ -z "$service_number" ]; then
            choose_service
        else
            case "$service_number" in
                1) SERVICE="移动" ;;
                2) SERVICE="电信" ;;
                3) SERVICE="联通" ;;
                4) SERVICE="校园网" ;;
                *)
                    error "无效的运营商编号：$service_number"
                    error "有效编号：1、2、3、4"
                    exit 2
                    ;;
            esac
        fi
    fi

    # ------------------------------------------------------------------------
    # 参数检查
    # ------------------------------------------------------------------------

    if [ -z "$user" ]; then
        error "账号不能为空。"
        exit 2
    fi

    if [ -z "$pass" ]; then
        error "密码不能为空。"
        exit 2
    fi

    if [ -z "${SERVICE:-}" ]; then
        error "运营商不能为空。"
        exit 2
    fi

    printf "\n"
    info "正在检测网络..."

    local response=""
    local curl_exit=0

    response=$(curl -s --max-time 10 "$TEST_URL") || curl_exit=$?

    if echo "$response" | grep -q "index\.jsp?"; then

        local qs
        qs=$(echo "$response" | grep -oP "index\.jsp\?\K[^'\"]+")

        info "检测到校园网认证门户"
        info "正在认证 ${BOLD}${user}${RESET} @ ${BOLD}${SERVICE}${RESET}..."

        local result

        result=$(curl -s -X POST \
            "${PORTAL}/eportal/InterFace.do?method=login" \
            -H "Content-Type: application/x-www-form-urlencoded; charset=UTF-8" \
            -H "User-Agent: Mozilla/5.0 (X11; Linux aarch64)" \
            -H "Referer: ${PORTAL}/eportal/index.jsp?${qs}" \
            -H "Origin: ${PORTAL}" \
            --data-urlencode "userId=${user}" \
            --data-urlencode "password=${pass}" \
            --data-urlencode "service=${SERVICE}" \
            --data-urlencode "queryString=${qs}" \
            -d "operatorPwd=" \
            -d "operatorUserId=" \
            -d "validcode=" \
            -d "passwordEncrypt=false")

        if echo "$result" | grep -q '"result":"success"'; then

            mkdir -p "$(dirname "$USER_INDEX")"

            echo "$result" |
                grep -oP '"userIndex":"\K[^"]+' > "$USER_INDEX"

            chmod 644 "$USER_INDEX"

            save_account_config "$user" "$pass" "$SERVICE"

            printf "\n"
            success "认证成功"
            printf "  账号：${BOLD}%s${RESET}\n" "$user"
            printf "  运营商：${BOLD}%s${RESET}\n" "$SERVICE"

        else
            local errmsg
            errmsg=$(echo "$result" | grep -oP '"message":"\K[^"]+' || true)

            printf "\n"
            error "认证失败"
            [ -n "$errmsg" ] && printf "  原因：%s\n" "$errmsg"

            return 1
        fi

    elif [ "$curl_exit" -eq 0 ] && [ -n "$response" ]; then

        success "当前已在线"

    elif curl -s --max-time 5 "$FALLBACK_URL" | grep -q "百度"; then

        success "当前已在线"

    else

        error "网络异常，无法连接外网"
        return 1

    fi
}

# ============================================================================
# 下线
# ============================================================================

do_logout() {
    title "校园网下线"

    if [ ! -f "$USER_INDEX" ] || [ ! -s "$USER_INDEX" ]; then
        warn "没有找到当前登录记录"
        return 0
    fi

    local user_index
    user_index=$(tr -d '\n' < "$USER_INDEX")

    info "正在下线..."

    local response

    response=$(curl -s -X POST \
        "${PORTAL}/eportal/InterFace.do?method=logout" \
        -d "userIndex=$user_index")

    if echo "$response" | grep -q '"result":"success"'; then

        rm -f "$USER_INDEX"
        success "下线成功"

    elif echo "$response" | grep -q '"message":"用户已不在线"'; then

        rm -f "$USER_INDEX"
        warn "当前账号已经离线"

    else

        error "下线失败"
        return 1

    fi
}

# ============================================================================
# 重新认证
# ============================================================================

do_relogin() {
    title "重新认证"

    do_logout || warn "下线未成功，继续尝试登录..."

    sleep 2

    do_login
}

# ============================================================================
# 状态
# ============================================================================

do_status() {
    title "校园网状态"

    if [ -f "$USER_INDEX" ] && [ -s "$USER_INDEX" ]; then
        success "存在登录记录"
    else
        info "没有登录记录"
    fi

    if load_account_config; then
        printf "\n"
        printf "  账号：${BOLD}%s${RESET}\n" "$USER"
        printf "  运营商：${BOLD}%s${RESET}\n" "$SERVICE"
    else
        printf "\n"
        info "尚未保存校园网账号"
    fi
}

# ============================================================================
# 配置
# ============================================================================

do_config() {
    title "校园网配置"

    printf "  公共配置：${BOLD}%s${RESET}\n" "$SYSTEM_CONFIG"
    printf "  账号配置：${BOLD}%s${RESET}\n" "$ACCOUNT_CONFIG"
    printf "  登录状态：${BOLD}%s${RESET}\n" "$USER_INDEX"

    if [ -f "$SYSTEM_CONFIG" ]; then
        printf "  配置版本：${BOLD}%s${RESET}\n" "${CONFIG_VERSION:-未知}"
    fi

    if load_account_config; then
        printf "  当前账号：${BOLD}%s${RESET}\n" "$USER"
        printf "  当前运营商：${BOLD}%s${RESET}\n" "$SERVICE"
    else
        printf "  当前账号：${DIM}未设置${RESET}\n"
    fi
}

# ============================================================================
# 主入口
# ============================================================================

main() {
    load_system_config

    local command="${1:-help}"

    case "$command" in

        login)
            shift

            if [ "$#" -gt 3 ]; then
                error "login 最多接受三个参数。"
                printf "\n"
                show_help
                exit 2
            fi

            do_login "${1:-}" "${2:-}" "${3:-}"
            ;;

        logout)
            [ "$#" -eq 1 ] || {
                error "logout 不接受参数。"
                exit 2
            }

            do_logout
            ;;

        relogin)
            [ "$#" -eq 1 ] || {
                error "relogin 不接受参数。"
                exit 2
            }

            do_relogin
            ;;

        status)
            [ "$#" -eq 1 ] || {
                error "status 不接受参数。"
                exit 2
            }

            do_status
            ;;

        config)
            [ "$#" -eq 1 ] || {
                error "config 不接受参数。"
                exit 2
            }

            do_config
            ;;

        version|--version|-v)
            printf "%s\n" "$VERSION"
            ;;

        help|--help|-h)
            show_help
            ;;

        *)
            error "未知命令：$command"
            printf "\n"
            show_help
            exit 2
            ;;

    esac
}

main "$@"
class MenuTerminal:
    """Keep terminal mode and queued input intact while navigating menu pages."""
    def __init__(self):
        self.window = None

    def open(self):
        import curses
        if self.window is None:
            self.window = curses.initscr()
            curses.noecho()
            curses.cbreak()
            self.window.keypad(False)
        return self.window

    def prompt(self, callback, *args):
        if self.window is None:
            return callback(*args)
        import curses
        curses.def_prog_mode()
        curses.endwin()
        try:
            return callback(*args)
        finally:
            curses.reset_prog_mode()
            self.window.keypad(False)
            self.window.clearok(True)

    def close(self):
        if self.window is None:
            return
        import curses
        for restore in (curses.flushinp, lambda: self.window.keypad(False),
                        curses.echo, curses.nocbreak, curses.endwin):
            try:
                restore()
            except curses.error:
                pass
        self.window = None


def read_menu_key(window):
    """Decode both CSI and SS3 arrows without mistaking their ESC for Back."""
    import curses
    key = window.getch()
    if key != 27:
        return key
    window.timeout(250)
    try:
        prefix = window.getch()
        if prefix == -1:
            return 27
        if prefix not in (ord("["), ord("O")):
            # ESC followed by another key: return Back, keep that key for the
            # next page (including the ESC which begins a following arrow).
            curses.ungetch(prefix)
            return 27
        for _ in range(32):
            final = window.getch()
            if final == -1:
                return -1
            if final == 27:
                curses.ungetch(final)
                return -1
            if 0x40 <= final <= 0x7e:
                return {ord("A"): curses.KEY_UP, ord("B"): curses.KEY_DOWN,
                        ord("C"): curses.KEY_RIGHT, ord("D"): curses.KEY_LEFT}.get(final, -1)
        return -1
    finally:
        window.timeout(-1)


def select_menu(title, rows, selected=0, terminal=None):
    import curses
    def screen(window):
        nonlocal selected
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        # Parse both normal and application cursor sequences ourselves; terminal
        # emulators may send either, especially immediately after an Escape.
        window.keypad(False)
        while True:
            height, width = window.getmaxyx()
            window.erase()
            selected = max(0, min(selected, len(rows) - 1))
            start = max(0, selected - max(1, height - 5) + 1)
            lines = [(0, title), (1, "↑↓选择  ←禁用  →启用  Enter详情  Esc返回")]
            lines += [(n + 3, row) for n, row in enumerate(rows[start:start + max(1, height - 4)])]
            for line, text in lines:
                try:
                    active = line >= 3 and line - 3 + start == selected
                    window.addnstr(line, 0, text, max(1, width - 1), curses.A_REVERSE if active else 0)
                except curses.error:
                    pass
            window.refresh()
            key = read_menu_key(window)
            if key == curses.KEY_UP:
                selected = (selected - 1) % len(rows)
            elif key == curses.KEY_DOWN:
                selected = (selected + 1) % len(rows)
            elif key in (27, ord("q")):
                return selected, "back"
            elif key in (10, 13, curses.KEY_ENTER, curses.KEY_LEFT, curses.KEY_RIGHT):
                return selected, "disable" if key == curses.KEY_LEFT else "enable" if key == curses.KEY_RIGHT else "enter"
    return screen(terminal.open()) if terminal is not None else curses.wrapper(screen)


def configure_menu(terminal):
    if not sys.stdin.isatty():
        raise ValueError("请在交互终端执行 campus-network config；自动化配置可使用 pool 从标准输入读取 JSON")
    page, selected = "home", 0
    while True:
        status = client({"command": "status"})
        if page == "home":
            rows = ["IP 池", "账号池", "在线模式 [%s]" % status["mode"], "返回"]
        else:
            rows = []
            for item in status[page]:
                label = item["address"] or "自动检测" if page == "ips" else item["username"] + " @ " + item["service"]
                extra = item["state"] if page == "ips" else "冷却 %ds" % item["cooldown_in"] if item["cooldown_in"] else "可用"
                rows.append("[%s]%s %s — %s" % ("启用" if item["enabled"] else "禁用", " 主" if item["primary"] else "", label, extra))
            rows.append("＋ 新建 IP" if page == "ips" else "＋ 新建账号")
        selected, key = select_menu("campus-network " + VERSION, rows, selected, terminal=terminal)
        if key == "back" or (page == "home" and selected == 3 and key == "enter"):
            if page == "home":
                return status
            page, selected = "home", 0
            continue
        if page == "home":
            if selected < 2 and key == "enter":
                page, selected = ("ips" if selected == 0 else "accounts"), 0
            elif selected == 2:
                result = client({"command": "on" if key == "enable" else "off" if key == "disable" else "off" if status["mode"] == "on" else "on"})
                if result.get("needs_account"):
                    terminal.prompt(input, "请先在账号池添加或启用账号。按 Enter 返回…")
            continue
        try:
            if selected == len(status[page]):
                if key == "enter":
                    client({"command": "pool-add", "kind": page, "value": terminal.prompt(prompt_ip if page == "ips" else prompt_account)})
            else:
                item = status[page][selected]
                request = {"kind": page, "id": item["id"]}
                if key in ("enable", "disable"):
                    client(dict(request, command="pool-enable", enabled=key == "enable"))
                else:
                    detail, operation = select_menu("条目详情：%s；编辑前请先禁用并等待释放" % rows[selected], ["设为主 IP" if page == "ips" else "设为主账号", "编辑", "返回"], terminal=terminal)
                    if operation == "enter" and detail == 0:
                        client(dict(request, command="pool-primary"))
                    elif operation == "enter" and detail == 1:
                        client(dict(request, command="pool-edit", value=terminal.prompt(prompt_ip if page == "ips" else prompt_account)))
        except ValueError as exc:
            terminal.prompt(input, "配置未保存：%s\n按 Enter 返回菜单…" % exc)


def configure():
    terminal = MenuTerminal()
    try:
        return configure_menu(terminal)
    finally:
        terminal.close()


def main():
    parser = argparse.ArgumentParser(description="校园网管理；on/off/status/config 均无需 sudo")
    parser.add_argument("command", nargs="?", choices=("on", "off", "status", "config", "pool"), default="status")
    parser.add_argument("--version", action="version", version=VERSION)
    parser.add_argument("--json", action="store_true", help="输出 JSON 状态")
    parser.add_argument("--daemon", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    try:
        if args.daemon:
            daemon()
            return 0
        if args.command == "config" and args.json:
            raise ValueError("config 需要交互输入，不支持 --json")
        if args.command == "pool":
            request = read_message(sys.stdin.buffer)
            if request.get("command") not in ("pool-add", "pool-enable", "pool-primary", "pool-edit"):
                raise ValueError("pool 仅接受账号池、IP 池变更命令")
            result = client(request)
        else:
            result = configure() if args.command == "config" else client({"command": args.command})
        if result.get("needs_account"):
            raise ValueError("尚未配置账号，请先执行 campus-network config")
        if args.json:
            print(json.dumps(result, ensure_ascii=False))
        else:
            print_status(result)
        return 0
    except (ConnectionError, FileNotFoundError, socket.timeout):
        print("连接管理服务不可用，当前连接状态未知；请检查 systemctl status campus-network", file=sys.stderr)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as exc:
        print("错误：%s" % exc, file=sys.stderr)
    except (KeyboardInterrupt, EOFError):
        print("\n已取消", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())

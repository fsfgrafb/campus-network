VERSION = "2.2.1"
CONFIG_DIR = Path("/etc/campus-network")
STATE_DIR = Path("/var/lib/campus-network")
RUNTIME_DIR = Path("/run/campus-network")
SERVICES = ("移动", "电信", "联通", "校园网")
DEFAULT_CONFIG = {
    "portal": "http://10.28.200.56:8080", "test_url": "http://1.1.1.1", "interface": "",
    "probe_urls": [
        {"url": "https://www.baidu.com", "status": 200, "contains": "百度"},
        {"url": "https://www.qq.com", "status": 200, "contains": "腾讯"},
    ],
    "check_interval": 3, "connect_timeout": 2, "request_timeout": 5,
    "retry_base": 2, "retry_max": 120, "initial_jitter": 3,
}


def read_json(path, default=None):
    try:
        return json.loads(Path(path).read_text(encoding="utf-8"))
    except FileNotFoundError:
        return default


def atomic_json(path, value):
    path = Path(path)
    fd, temporary = tempfile.mkstemp(prefix="." + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(value, stream, ensure_ascii=False)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        if sys.platform == "linux":
            directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
            try:
                os.fsync(directory)
            finally:
                os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def load_config(path):
    config = dict(DEFAULT_CONFIG, **read_json(path, {}))
    for key in ("check_interval", "connect_timeout", "request_timeout", "retry_base", "retry_max", "initial_jitter"):
        value = config[key]
        if isinstance(value, bool) or not isinstance(value, (int, float)) or not math.isfinite(value) or value < (0 if key == "initial_jitter" else .01):
            raise ValueError("配置 %s 必须是有效的时间间隔" % key)
    if config["initial_jitter"] > 30 or config["request_timeout"] > 8 or config["connect_timeout"] > config["request_timeout"]:
        raise ValueError("initial_jitter 不得超过 30 秒，请求超时不得超过 8 秒，连接超时不得超过总超时")
    if config["retry_max"] < config["retry_base"]:
        raise ValueError("retry_max 不得小于 retry_base")
    if not isinstance(config["interface"], str) or len(config["interface"]) > 15:
        raise ValueError("interface 必须是 Linux 网卡名或空字符串")
    for key in ("portal", "test_url"):
        parsed = urlsplit(config[key])
        if parsed.scheme not in ("http", "https") or not parsed.hostname or parsed.username:
            raise ValueError("无效的 URL：" + key)
    if not config["probe_urls"] or len(config["probe_urls"]) > 2:
        raise ValueError("配置一到两个 HTTPS 外网探测地址")
    for probe in config["probe_urls"]:
        if urlsplit(probe["url"]).scheme != "https" or not isinstance(probe["status"], int):
            raise ValueError("外网探测必须使用 HTTPS 和明确的 status")
        if probe["status"] != 204 and not probe.get("contains"):
            raise ValueError("非 204 探测必须配置 contains")
    return config


def valid_account(value):
    if not isinstance(value, dict):
        raise ValueError("账号配置必须是对象")
    if any(not isinstance(value.get(k), str) or not 0 < len(value[k]) <= 512 for k in ("username", "password")):
        raise ValueError("账号和密码不能为空，且不得超过 512 个字符")
    if re.search(r"[\x00-\x1f\x7f-\x9f]", value["username"]):
        raise ValueError("账号不得包含控制字符")
    if value.get("service") not in SERVICES:
        raise ValueError("运营商必须是移动、电信、联通或校园网")
    return {key: value[key] for key in ("username", "password", "service")}


def shell_values(path, keys):
    values = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        key, separator, value = line.partition("=")
        if separator and key in keys:
            if value.startswith("$'"):
                values[key] = ast.literal_eval(value[1:].replace(r"\e", r"\x1b").replace(r"\E", r"\x1b"))
                if value.isascii() and re.search(r"\\(?:[0-7]{3}|x[0-9a-fA-F]{2})", value):
                    try:
                        values[key] = values[key].encode("latin1").decode("utf-8")
                    except UnicodeError:
                        pass
            else:
                parts = shlex.split(value, comments=False)
                values[key] = parts[0] if len(parts) == 1 else ""
    return values


def migrate_legacy(account_path, state_dir):
    # The old account file was world-writable: parse data, never execute it.
    if not account_path.exists():
        old_config = account_path.with_name("config")
        config_path = account_path.with_name("config.json")
        if old_config.exists():
            config = read_json(config_path, {})
            for key, value in shell_values(old_config, ("PORTAL", "TEST_URL")).items():
                new_key = {"PORTAL": "portal", "TEST_URL": "test_url"}[key]
                if config.get(new_key, DEFAULT_CONFIG[new_key]) == DEFAULT_CONFIG[new_key]:
                    config[new_key] = value
            atomic_json(config_path, config)
        old = account_path.with_name("account")
        if old.exists():
            try:
                values = shell_values(old, ("USER", "PASS", "SERVICE"))
                atomic_json(account_path, valid_account({
                    "username": values.get("USER"), "password": values.get("PASS"), "service": values.get("SERVICE"),
                }))
                old.chmod(0o600)
                logging.info("已迁移旧账号配置")
            except (ValueError, SyntaxError):
                logging.warning("旧账号配置无法自动迁移；请执行 campus-network config")
    old_index = state_dir / "userindex"
    if not (state_dir / "state.json").exists() and old_index.exists():
        atomic_json(state_dir / "state.json", {
            "mode": "off", "session": old_index.read_text().strip(), "generation": 0,
        })
        old_index.unlink()


class Portal:
    def __init__(self, config, runner=None):
        self.config = dict(DEFAULT_CONFIG, **config)
        self.runner = runner or subprocess.run
        self.interface = self.config["interface"]
        self.cancelled = lambda: False

    def request(self, url, fields=None, headers=None, timeout=None):
        timeout = timeout or self.config["request_timeout"]
        command = ["curl", "-q", "-sS", "--ipv4", "--noproxy", "*", "--proto", "=http,https",
                   "--connect-timeout", str(self.config["connect_timeout"]), "--max-time", str(timeout),
                   "--max-filesize", "1048576", "--write-out", "\n%{http_code}"]
        if self.interface:
            command += ["--interface", self.interface]
        for key, value in (headers or {}).items():
            command += ["-H", key + ": " + value]
        data = None
        if fields is not None:
            command += ["-X", "POST", "--data-binary", "@-"]
            data = urlencode(fields, quote_via=quote).encode("utf-8")
        command += ["--url", url]
        result = self.runner(command, input=data, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout + 1)
        if result.returncode:
            raise OSError("HTTP 请求失败（curl %s）" % result.returncode)
        body, _, status = result.stdout.decode("utf-8", errors="replace").rpartition("\n")
        return int(status), body

    def probe(self):
        try:
            _, body = self.request(self.config["test_url"], timeout=min(3, self.config["request_timeout"]))
            match = re.search(r"index\.jsp\?([^'\"<>\s]+)", body)
            if match:
                return {"kind": "portal", "query": html.unescape(match[1]), "reason": "需要进行校园网认证"}
        except (OSError, ValueError, subprocess.TimeoutExpired):
            pass
        for probe in self.config["probe_urls"]:
            if self.cancelled():
                break
            try:
                status, body = self.request(probe["url"], timeout=min(3, self.config["request_timeout"]))
                if status == probe["status"] and probe.get("contains", "") in body:
                    return {"kind": "online", "reason": "外网连通性检查通过"}
            except (OSError, ValueError, subprocess.TimeoutExpired):
                pass
        return {"kind": "unknown", "reason": "外网连通性检查未通过，等待网络或认证服务恢复"}

    def login(self, account, query):
        portal = self.config["portal"].rstrip("/")
        _, body = self.request(portal + "/eportal/InterFace.do?method=login", fields={
            "userId": account["username"], "password": account["password"], "service": account["service"],
            "queryString": query, "operatorPwd": "", "operatorUserId": "", "validcode": "", "passwordEncrypt": "false",
        }, headers={
            "Content-Type": "application/x-www-form-urlencoded; charset=UTF-8",
            "User-Agent": "Mozilla/5.0 (X11; Linux aarch64)",
            "Referer": portal + "/eportal/index.jsp?" + query, "Origin": portal,
        })
        result = json.loads(body)
        if not isinstance(result, dict):
            raise ValueError("认证响应必须是对象")
        return result

    def logout(self, user_index):
        _, body = self.request(self.config["portal"].rstrip("/") + "/eportal/InterFace.do?method=logout",
                               fields={"userIndex": user_index})
        result = json.loads(body)
        if not isinstance(result, dict):
            raise ValueError("注销响应必须是对象")
        return result


def inspect_network(interface=""):
    import fcntl
    import struct

    routes = []
    for line in Path("/proc/net/route").read_text().splitlines()[1:]:
        row = line.split()
        if len(row) >= 8 and row[1] == "00000000" and int(row[3], 16) & 1:
            routes.append(row)
    routes.sort(key=lambda row: int(row[6]))
    route = next((row for row in routes if not interface or row[0] == interface), None)
    interface = interface or (route[0] if route else "")
    carrier, address = "unknown", ""
    if interface:
        try:
            carrier = (Path("/sys/class/net") / interface / "carrier").read_text().strip()
        except OSError:
            pass
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
                answer = fcntl.ioctl(sock.fileno(), 0x8915, struct.pack("256s", interface.encode()[:15]))
                address = socket.inet_ntoa(answer[20:24])
        except OSError:
            pass
    ready = bool(interface and route and address and carrier != "0")
    return {"ready": ready, "interface": interface, "link": carrier != "0",
            "signature": (interface, carrier, address, tuple(route[i] for i in (0, 1, 2, 3, 6, 7)) if route else ()),
            "reason": "网络链路未连接" if carrier == "0" else "等待网卡、IPv4 地址或默认路由就绪"}


class Controller:
    def __init__(self, config, state_dir, account_path, portal=None, network=None, clock=time.monotonic, rng=random.uniform):
        self.config = dict(DEFAULT_CONFIG, **config)
        self.state_dir, self.account_path = Path(state_dir), Path(account_path)
        self.state_dir.mkdir(parents=True, exist_ok=True)
        self.state_path = self.state_dir / "state.json"
        self.state = read_json(self.state_path, {"mode": "off", "session": "", "generation": 0})
        if (self.state.get("mode") not in ("on", "off") or not isinstance(self.state.get("session"), str)
                or not isinstance(self.state.get("generation"), int)):
            raise ValueError("持久状态损坏，请检查 state.json；为避免抢占账号，拒绝自动登录")
        self.portal = portal or Portal(self.config)
        self.network = network or (lambda: inspect_network(self.config["interface"]))
        self.clock, self.rng = clock, rng
        self.lock, self.wake = threading.RLock(), threading.Event()
        self.failures, self.next_action, self.last_network = 0, 0, None
        self.heartbeat = time.time()
        self.status = {"state": "starting", "reason": "正在检查", "last_online": None, "changed_at": time.time()}

    def _save(self, **updates):
        state = dict(self.state, **updates)
        atomic_json(self.state_path, state)
        self.state = state

    def _account(self):
        try:
            value = read_json(self.account_path)
            return valid_account(value) if value is not None else None
        except (OSError, ValueError, TypeError):
            return None

    def _report(self, state, reason):
        with self.lock:
            account = self._account()
            reason = str(reason)
            for secret in ((account or {}).get("password"), self.state["session"]):
                if secret:
                    reason = reason.replace(secret, "***")
            reason = re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", str(reason))[:240]
            if state != self.status["state"] or reason != self.status["reason"]:
                self.status.update(state=state, reason=reason, changed_at=time.time())
                logging.info("%s: %s", state, reason)
            if state == "online":
                self.status["last_online"] = time.time()

    def snapshot(self):
        with self.lock:
            account = self._account()
            status = dict(self.status)
            if time.time() - self.heartbeat > 25:
                status.update(state="service-unresponsive", reason="连接管理服务响应超时，等待 systemd 恢复；连接状态未知")
            return dict(status, mode=self.state["mode"], version=VERSION, configured=bool(account),
                        username=(account or {}).get("username", ""), service=(account or {}).get("service", ""),
                        retry_in=round(max(0, self.next_action - self.clock()), 1), failures=self.failures,
                        pending_release=bool(self.state["mode"] == "off" and (self.state["session"] or self.state.get("uncertain"))),
                        heartbeat=self.heartbeat, pid=os.getpid())

    def command(self, request):
        action = request.get("command")
        if action not in ("on", "off", "status", "config"):
            raise ValueError("仅支持 on、off、status、config")
        with self.lock:
            if action == "config":
                account = valid_account(request.get("account"))
                if self.state["mode"] != "off" or self.state["session"] or self.state.get("uncertain"):
                    raise ValueError("旧会话尚未注销或在线模式已重新启用，原账号保持不变；请稍后重试 config")
                atomic_json(self.account_path, account)
                self._report("idle", "账号配置已保存；执行 campus-network on 启用在线模式")
                return self.snapshot()
            if action != "status":
                if action == "on":
                    if "account" in request:
                        raise ValueError("请使用 campus-network config 配置账号")
                    if not self._account():
                        return {"needs_account": True}
                if self.state["mode"] != action:
                    self._save(mode=action, generation=self.state["generation"] + 1)
                    self.failures, self.next_action = 0, 0
                    self._report("checking" if action == "on" else "releasing" if self.state["session"] or self.state.get("uncertain") else "idle",
                                 "已启用在线模式，将自动维持网络连接" if action == "on" else "已启用离线模式，自动认证已停用")
                self.wake.set()
            return self.snapshot()

    def _retry(self, state, reason):
        with self.lock:
            ceiling = min(self.config["retry_max"], self.config["retry_base"] * 2 ** min(self.failures, 30))
            self.failures += 1
            self.next_action = self.clock() + self.rng(ceiling / 2, ceiling)
            self._report(state, reason)

    def step(self):
        network = self.network()
        with self.lock:
            signature = network["signature"]
            if signature != self.last_network:
                self.last_network = signature
                self.failures = 0
                self.next_action = self.clock() + self.rng(0, self.config["initial_jitter"])
            mode, generation, session = self.state["mode"], self.state["generation"], self.state["session"]
            self.portal.interface = network.get("interface", "") or self.config["interface"]
            if mode == "off" and not session:
                self._report("release-unconfirmed" if self.state.get("uncertain") else "idle",
                             "自动认证已停用；上次认证结果未知，缺少会话标识，无法确认注销状态" if self.state.get("uncertain") else "自动认证已停用，无待注销会话")
                return
            if not network["ready"]:
                self._report("waiting-link" if not network["link"] else "waiting-network",
                             network["reason"] + ("；现有会话等待注销" if mode == "off" else ""))
                return
            if self.clock() < self.next_action:
                return
            account = self._account() if mode == "on" else None
            if mode == "on" and not account:
                self._report("config-error", "账号未配置，请执行 campus-network config")
                return
        try:
            if mode == "off":
                self._report("releasing", "正在向认证服务器提交注销请求")
                result = self.portal.logout(session)
                with self.lock:
                    if result.get("result") == "success" or result.get("message") == "用户已不在线":
                        self._save(session="")
                        self.failures, self.next_action = 0, 0
                        unknown = self.state.get("uncertain") and self.state["mode"] == "off"
                        self._report("release-unconfirmed" if unknown else "idle" if self.state["mode"] == "off" else "checking",
                                     "已注销已知会话；另一次认证结果未知，注销状态尚未确认" if unknown else "会话注销完成")
                    elif self.state["generation"] == generation:
                        self._retry("releasing", result.get("message") or "会话注销失败，将按重试计划重新尝试")
                return
            self.portal.cancelled = lambda: self.state["generation"] != generation or not self.network()["ready"]
            result = self.portal.probe()
            with self.lock:
                if self.state["generation"] != generation:
                    return
                if self.network()["signature"] != signature:
                    self.wake.set()
                    return
                if result["kind"] == "online":
                    self.failures = 0
                    self.next_action = self.clock() + self.rng(self.config["check_interval"] * .8, self.config["check_interval"] * 1.2)
                    self._report("online", result["reason"])
                    return
                if result["kind"] != "portal":
                    self._retry("retrying", result["reason"])
                    return
                # Mark the operation in flight before releasing the control lock.
                uncertain_before = self.state.get("uncertain", False)
                self._save(uncertain=True)
                self._report("authenticating", "正在提交校园网认证")
            result = self.portal.login(account, result["query"])
            with self.lock:
                if result.get("result") == "success" and result.get("userIndex"):
                    self._save(session=str(result["userIndex"]), uncertain=False)
                    if self.state["mode"] == "on":
                        self._retry("checking", "认证成功，等待外网连通性确认")
                    else:
                        self.failures, self.next_action = 0, 0
                        self._report("releasing", "认证期间已切换为离线模式，正在注销新会话")
                    self.wake.set()
                else:
                    if result.get("result") != "success":
                        self._save(uncertain=uncertain_before)
                    if self.state["generation"] == generation:
                        self._retry("retrying", result.get("message") or "认证失败或未返回会话索引")
        except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
            with self.lock:
                if self.state["generation"] == generation:
                    reason = "请求超时，认证服务器处理结果尚未确认" if isinstance(exc, subprocess.TimeoutExpired) else "请求失败，将按重试计划重新尝试"
                    self._retry("releasing" if mode == "off" else "retrying", reason)


def notify(message):
    address = os.environ.get("NOTIFY_SOCKET")
    if address:
        try:
            with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
                sock.sendto(message.encode(), "\0" + address[1:] if address.startswith("@") else address)
        except OSError:
            pass


def read_message(stream):
    line = stream.readline(8193)
    if not line.endswith(b"\n") or len(line) > 8192:
        raise ValueError("控制消息过长或不完整")
    value = json.loads(line)
    if not isinstance(value, dict):
        raise ValueError("控制消息必须是对象")
    return value


def daemon():
    import fcntl
    import socketserver

    if os.geteuid() != 0:
        raise ValueError("守护进程由 systemd 以 root 启动；日常命令无需 sudo")
    os.umask(0o077)
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    RUNTIME_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    RUNTIME_DIR.chmod(0o755)
    lock = (RUNTIME_DIR / "daemon.lock").open("w")
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    migrate_legacy(CONFIG_DIR / "account.json", STATE_DIR)
    config = load_config(CONFIG_DIR / "config.json")
    control = Controller(config, STATE_DIR, CONFIG_DIR / "account.json")

    class Handler(socketserver.StreamRequestHandler):
        def handle(self):
            self.request.settimeout(2)
            try:
                result = control.command(read_message(self.rfile))
            except ValueError as exc:
                result = {"error": str(exc)}
            except (OSError, TypeError, KeyError):
                result = {"error": "请求无效或配置不可读，请检查服务日志与账号配置"}
            try:
                self.wfile.write((json.dumps(result, ensure_ascii=False) + "\n").encode())
            except OSError:
                pass

    endpoint = RUNTIME_DIR / "control.sock"
    endpoint.unlink(missing_ok=True)
    class Server(socketserver.ThreadingMixIn, socketserver.UnixStreamServer):
        daemon_threads = True

    server = Server(str(endpoint), Handler)
    endpoint.chmod(0o666)
    thread = threading.Thread(target=server.serve_forever, kwargs={"poll_interval": .2}, daemon=True)
    thread.start()
    stopping = threading.Event()

    def stop(*_):
        stopping.set()
        control.wake.set()

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    try:
        while not stopping.is_set():
            control.wake.clear()
            if not thread.is_alive():
                raise RuntimeError("控制服务意外退出")
            control.step()
            control.heartbeat = time.time()
            notify("WATCHDOG=1")
            control.wake.wait(1)
    finally:
        server.shutdown()
        server.server_close()
        endpoint.unlink(missing_ok=True)
        lock.close()


def client(request):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        sock.settimeout(4)
        sock.connect(str(RUNTIME_DIR / "control.sock"))
        sock.sendall((json.dumps(request, ensure_ascii=False) + "\n").encode())
        with sock.makefile("rb") as stream:
            result = read_message(stream)
    if "error" in result:
        raise ValueError(result["error"])
    return result


def print_status(value):
    labels = {"online": "在线", "idle": "离线", "starting": "启动中", "checking": "检查连接",
              "waiting-link": "等待链路恢复", "waiting-network": "等待网络就绪", "authenticating": "认证中",
              "retrying": "等待重试", "releasing": "正在注销", "release-unconfirmed": "注销未确认",
              "config-error": "配置错误", "service-unresponsive": "服务无响应"}
    state = value.get("state", "starting")
    color = sys.stdout.isatty() and "NO_COLOR" not in os.environ
    text = labels.get(state, state)
    if color:
        text = "\033[%sm%s\033[0m" % ("32" if state == "online" else "36" if state == "idle" else "33", text)
    print("模式：%s    状态：%s" % ("保持在线" if value["mode"] == "on" else "保持离线", text))
    print("说明：" + value["reason"])
    if value.get("username"):
        print("账号：%s @ %s" % (value["username"], value["service"]))
    if value.get("pending_release"):
        print("会话：等待注销确认（自动认证已停用）")
    if value.get("retry_in", 0) > 0 and state != "online":
        print("下次重试：%.1f 秒后" % value["retry_in"])
    if value.get("last_online"):
        print("最近在线：" + time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(value["last_online"])))
    print("状态更新：" + time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(value["changed_at"])))


def configure():
    current = client({"command": "status"})
    if not sys.stdin.isatty():
        raise ValueError("请在交互终端执行 campus-network config 配置账号")
    if current.get("username"):
        print("当前账号：%s @ %s" % (current["username"], current["service"]))
    username = input("校园网账号：").strip()
    password = getpass.getpass("校园网密码：")
    choice = input("运营商 [1 移动 / 2 电信 / 3 联通 / 4 校园网]：").strip()
    service = SERVICES[int(choice) - 1] if choice in ("1", "2", "3", "4") else choice
    account = valid_account({"username": username, "password": password, "service": service})
    status = client({"command": "off"})
    deadline = time.monotonic() + 15
    while status.get("pending_release"):
        if status.get("state") == "release-unconfirmed" or time.monotonic() >= deadline:
            raise ValueError("旧会话注销尚未确认，原账号保持不变，自动认证已停用；请稍后再次执行 config")
        time.sleep(.2)
        status = client({"command": "status"})
    return client({"command": "config", "account": account})


def main():
    parser = argparse.ArgumentParser(description="校园网管理；on/off/status/config 均无需 sudo")
    parser.add_argument("command", nargs="?", choices=("on", "off", "status", "config"), default="status")
    parser.add_argument("--version", action="version", version=VERSION)
    parser.add_argument("--json", action="store_true", help="输出 JSON 状态")
    parser.add_argument("--daemon", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()
    logging.basicConfig(level=logging.INFO, format="%(message)s")
    try:
        if args.daemon:
            daemon()
            return 0
        if args.command == "config" and args.json:
            raise ValueError("config 需要交互输入，不支持 --json")
        result = configure() if args.command == "config" else client({"command": args.command})
        if result.get("needs_account"):
            raise ValueError("尚未配置账号，请先执行 campus-network config")
        if args.json:
            print(json.dumps(result, ensure_ascii=False))
        else:
            print_status(result)
        return 0
    except (ConnectionError, FileNotFoundError, socket.timeout):
        print("连接管理服务不可用，当前连接状态未知；请检查 systemctl status campus-network", file=sys.stderr)
    except (OSError, ValueError, KeyError, TypeError, RuntimeError) as exc:
        print("错误：%s" % exc, file=sys.stderr)
    except (KeyboardInterrupt, EOFError):
        print("\n已取消", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
